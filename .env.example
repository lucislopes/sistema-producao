# Copie este arquivo para .env somente no servidor e use valores fortes.
# Nao reutilize senhas de usuarios ou do banco nesta chave.
JWT_SECRET=gere_uma_chave_longa_aleatoria_aqui
CORS_ORIGINS=https://seu-dominio.com

# Usada apenas ao executar o seed ou o script criar-admin manualmente.
ADMIN_PASSWORD=defina_uma_senha_inicial_forte

# Opcional no desenvolvimento. No Docker, o compose usa /app/uploads com volume persistente.
# UPLOAD_DIR=C:/sistema-producao/backend/uploads
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
META_GRAPH_VERSION=v25.0
SITE_PUBLIC_URL=

# Login oficial Instagram: credenciais somente no servidor.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Chave estável para cifrar o token conectado; trocar exige reconectar.
INSTAGRAM_TOKEN_SECRET=
