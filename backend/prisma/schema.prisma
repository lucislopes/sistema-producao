generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ConfiguracaoEmpresa {
  limiteFretesEmpresaDia Int?
  limiteFretesClienteDia Int?
  limiteChapasDia Int?
  id        String   @id @default(cuid())
  nome      String
  telefone  String?
  email     String?
  endereco  String?
  cidade    String?
  estado    String?
  cnpj      String?
  logoUrl   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ConfiguracaoSite {
  ajustesImagens Json @default("{}")
  id            String   @id @default("principal")
  ativo         Boolean  @default(false)
  corPrimaria   String   @default("#084f2b")
  corDestaque    String   @default("#ffbd16")
  whatsapp      String?
  instagramUrl  String?
  redesSociais  Json     @default("{}")
  siteUrl       String?
  sistemaUrl    String?
  conteudo      Json     @default("{}")
  imagemHomeUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CategoriaSite {
  ajusteImagem Json @default("{}")
  id          String        @id @default(cuid())
  nome        String
  slug        String        @unique
  descricao   String?
  imagemUrl   String?
  ativo       Boolean       @default(false)
  ordem       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  produtos    ProdutoSite[]
}

model ProdutoSite {
  ajusteImagem Json @default("{}")
  id                 String         @id @default(cuid())
  nome               String
  slug               String         @unique
  descricaoCurta     String?
  descricao          String?
  imagemPrincipalUrl String?
  tipoVenda          String         @default("MATERIAL")
  preco              Decimal?       @db.Decimal(12,2)
  precoAnterior      Decimal?       @db.Decimal(12,2)
  marca              String?
  condicao           String?
  especificacao      String?
  ativo              Boolean        @default(false)
  destaque           Boolean        @default(false)
  ordem              Int            @default(0)
  categoriaId        String?
  categoria          CategoriaSite? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  @@index([categoriaId])
  @@index([ativo, ordem])
}

model BannerSite {
  ajusteImagem Json @default("{}")
  id          String   @id @default(cuid())
  titulo      String
  subtitulo   String?
  imagemUrl   String?
  link        String?
  textoBotao  String?
  ativo       Boolean  @default(false)
  ordem       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Cliente {
  acessoSite AcessoClienteSite?
  id        String   @id @default(cuid())
  nome      String
  documento String?
  telefone  String?
  endereco  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  email     String?
  pedidos   Pedido[]

  @@index([nome])
  @@index([documento])
}

model AnexoOrcamentoSite {
  id String @id @default(uuid())
  orcamentoId String
  orcamento OrcamentoSite @relation(fields:[orcamentoId], references:[id], onDelete:Cascade)
  nome String
  mime String
  bytes Int
  hash String
  arquivo String
  createdAt DateTime @default(now())
  expiraEm DateTime
  removidoEm DateTime?
  @@unique([orcamentoId, hash])
  @@index([removidoEm, expiraEm])
}

model OrcamentoSite {
  id String @id @default(cuid())
  anexos AnexoOrcamentoSite[]
  protocolo Int @unique @default(autoincrement())
  chave String @unique
  nome String
  telefone String
  email String?
  documento String?
  detalhes Json
  status String @default("NOVO")
  responsavelId String?
  notaInterna String?
  proposta String?
  valor Decimal? @db.Decimal(10,2)
  primeiroAtendimento DateTime?
  pedidoId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
  @@index([createdAt, id])
}

model AcessoClienteSite {
  id String @id @default(cuid())
  clienteId String @unique
  cliente Cliente @relation(fields:[clienteId], references:[id], onDelete:Cascade)
  senhaHash String?
  conviteHash String? @unique
  conviteExpira DateTime?
  ativo Boolean @default(true)
  versao Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AvisoPedidoSite {
  pedidoId String @id
  avisadoEm DateTime
  usuarioId String
}

model Funcionario {
  id           String            @id @default(cuid())
  nome         String
  telefone     String?
  funcao       FuncaoFuncionario
  ativo        Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  pedidosVenda Pedido[]          @relation("VendedorPedidos")
  servicos     ServicoPlano[]    @relation("OperadorServicos")
  usuario      Usuario?

  @@index([nome])
  @@index([funcao])
  @@index([ativo])
}

model Usuario {
  permissoesSite String[] @default([])
  somenteSite Boolean @default(false)
  id            String            @id @default(cuid())
  email         String            @unique
  senha         String
  funcionarioId String            @unique
  createdAt     DateTime          @default(now())
  historicos    HistoricoPedido[]
  funcionario   Funcionario       @relation(fields: [funcionarioId], references: [id])
}

model InstagramConexaoSite {
  id String @id @default("principal")
  conta String?
  username String?
  tokenCifrado String? @db.Text
  expiraEm DateTime?
  nonceHash String?
  usuarioId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model InstagramEnvioSite {
  id String @id @default(cuid())
  publicacaoId String
  publicacao PublicacaoSite @relation(fields:[publicacaoId], references:[id], onDelete:Cascade)
  formato String
  estado String @default("MANUAL")
  container String?
  instagramId String?
  conta String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([publicacaoId, formato])
}
model PublicacaoSite {
  ajusteImagem Json @default("{}")
  instagramEnvios InstagramEnvioSite[]
  id String @id @default(cuid())
  tipo String @default("PROMOCAO")
  titulo String
  descricao String @db.Text
  imagemUrl String?
  preco Decimal? @db.Decimal(10,2)
  precoAnterior Decimal? @db.Decimal(10,2)
  inicio DateTime?
  fim DateTime?
  status String @default("RASCUNHO")
  destaque Boolean @default(false)
  ordem Int @default(0)
  arte Json @default("{}")
  instagramId String?
  instagramContainer String?
  instagramEstado String @default("MANUAL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, inicio, fim])
}

model PaginaSite {
  ajusteImagem Json @default("{}")
  id String @id @default(cuid())
  slug String @unique
  titulo String
  descricao String @db.Text
  imagemUrl String?
  link String?
  tipo String @default("SERVICO")
  ativo Boolean @default(false)
  ordem Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([tipo, ativo, ordem])
}

model RotaEntrega {
  id         String   @id @default(cuid())
  nome       String
  valorFrete Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
  pedidos    Pedido[]

  @@index([nome])
}

model Pedido {
  origemComercial OrigemComercialPedido?
  id                 String            @id @default(cuid())
  numeroPedido       Int               @default(autoincrement())
  tipoPedido         TipoPedido        @default(COM_PRODUCAO)
  clienteId          String
  vendedorId         String
  dataPedido         DateTime          @default(now())
  dataEntrega        DateTime?
  tipoEntrega        TipoEntrega
  responsavelFrete   ResponsavelFrete?
  rotaId             String?
  valorFrete           Decimal?        @db.Decimal(10,2)
  valorFretePadrao     Decimal?        @db.Decimal(10, 2)
  valorFreteCobrado    Decimal?        @db.Decimal(10, 2)
  freteAlterado        Boolean         @default(false)
  motivoAlteracaoFrete String?
  nomeRecebedor      String?
  contatoRecebedor   String?
  enderecoEntrega    String?
  status             StatusPedido      @default(ABERTO)
  observacoes        String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  valorTotal         Decimal?          @db.Decimal(10, 2)
  quantidadeChapasDiretoEntrega Int?
  numeroPedidoManual String?            
  origemPedido       String            @default("INTERNO")
  historicos         HistoricoPedido[]
  cliente            Cliente           @relation(fields: [clienteId], references: [id])
  rota               RotaEntrega?      @relation(fields: [rotaId], references: [id])
  vendedor           Funcionario       @relation("VendedorPedidos", fields: [vendedorId], references: [id])
  planos             PlanoCorte[]

  @@index([numeroPedido])
  @@index([numeroPedidoManual])
  @@index([origemPedido])
  @@index([clienteId])
  @@index([clienteId, status, updatedAt])
  @@index([vendedorId])
  @@index([rotaId])
  @@index([status])
  @@index([dataEntrega])
  @@index([dataPedido])
  @@index([createdAt])
  @@index([updatedAt])

  @@unique([origemPedido, numeroPedidoManual])
}

model PlanoCorte {
  id                  String         @id @default(cuid())
  pedidoId            String
  numeroPlano         String
  quantidadeChapas    Int            @default(0)
  medidaEncabecamento String?
  compraExterna       Boolean        @default(false)
  observacoes         String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  pedido              Pedido         @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  servicos            ServicoPlano[]

  @@index([pedidoId])
  @@index([numeroPlano])
  @@index([createdAt])
}

model TipoServico {
  id       String         @id @default(cuid())
  nome     String         @unique
  servicos ServicoPlano[]
}

model ServicoPlano {
  id            String        @id @default(cuid())
  planoId       String
  tipoServicoId String
  operadorId    String?
  status        StatusServico @default(ABERTO)
  observacoes   String?
  dataInicio    DateTime?
  dataFim       DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  operador      Funcionario?  @relation("OperadorServicos", fields: [operadorId], references: [id])
  plano         PlanoCorte    @relation(fields: [planoId], references: [id], onDelete: Cascade)
  tipoServico   TipoServico   @relation(fields: [tipoServicoId], references: [id])

  @@index([planoId])
  @@index([tipoServicoId])
  @@index([operadorId])
  @@index([status])
  @@index([dataInicio])
  @@index([dataFim])
  @@index([createdAt])
  @@index([updatedAt])
}

model HistoricoPedido {
  id        String        @id @default(cuid())
  pedidoId  String
  usuarioId String?
  tipo      TipoHistorico
  descricao String
  createdAt DateTime      @default(now())
  pedido    Pedido        @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  usuario   Usuario?      @relation(fields: [usuarioId], references: [id])

  @@index([pedidoId])
  @@index([usuarioId])
  @@index([tipo])
  @@index([createdAt])
}

enum FuncaoFuncionario {
  ADMIN
  VENDEDOR
  OPERADOR
  VENDEDOR_OPERADOR
}

enum TipoEntrega {
  CLIENTE_RETIRA
  ENTREGA_EMPRESA
}

enum ResponsavelFrete {
  CLIENTE
  EMPRESA
}

enum StatusPedido {
  ABERTO
  EM_SEPARACAO
  EM_PRODUCAO
  CONCLUIDO
  PRONTO_ENTREGA
  SAIU_ENTREGA
  ENTREGUE
  CANCELADO
}

enum StatusServico {
  ABERTO
  INICIADO
  CONCLUIDO
  CANCELADO
}

enum TipoPedido {
  COM_PRODUCAO
  DIRETO_ENTREGA
}

enum TipoHistorico {
  PEDIDO_CRIADO
  PEDIDO_ATUALIZADO
  PLANO_CRIADO
  PLANO_ATUALIZADO
  PLANO_EXCLUIDO
  SERVICO_CRIADO
  SERVICO_ATUALIZADO
  SERVICO_EXCLUIDO
  SERVICO_ASSUMIDO
  STATUS_SERVICO_ALTERADO
  STATUS_PEDIDO_ALTERADO
  EXPEDICAO_ATUALIZADA
  FRETE_ALTERADO
}

model OrigemComercialPedido {
 pedidoId String @id
 origem String @default("SISTEMA")
 contatoRecebidoEm DateTime?
 primeiraRespostaEm DateTime?
 updatedAt DateTime @default(now()) @updatedAt
 pedido Pedido @relation(fields:[pedidoId], references:[id], onDelete:Cascade, onUpdate:NoAction)
 @@index([origem])
}
