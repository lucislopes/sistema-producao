generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ConfiguracaoEmpresa {
  id        String   @id @default(cuid())
  nome      String
  telefone  String?
  email     String?
  endereco  String?
  cidade    String?
  estado    String?
  cnpj      String?
  logoUrl   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cliente {
  id        String   @id @default(cuid())
  nome      String
  documento String?
  telefone  String?
  endereco  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  email     String?
  pedidos   Pedido[]

  @@index([nome])
  @@index([documento])
}

model Funcionario {
  id           String            @id @default(cuid())
  nome         String
  telefone     String?
  funcao       FuncaoFuncionario
  ativo        Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  pedidosVenda Pedido[]          @relation("VendedorPedidos")
  servicos     ServicoPlano[]    @relation("OperadorServicos")
  usuario      Usuario?

  @@index([nome])
  @@index([funcao])
  @@index([ativo])
}

model Usuario {
  id            String            @id @default(cuid())
  email         String            @unique
  senha         String
  funcionarioId String            @unique
  createdAt     DateTime          @default(now())
  historicos    HistoricoPedido[]
  funcionario   Funcionario       @relation(fields: [funcionarioId], references: [id])
}

model RotaEntrega {
  id         String   @id @default(cuid())
  nome       String
  valorFrete Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
  pedidos    Pedido[]

  @@index([nome])
}

model Pedido {
  id                 String            @id @default(cuid())
  numeroPedido       Int               @default(autoincrement())
  tipoPedido         TipoPedido        @default(COM_PRODUCAO)
  clienteId          String
  vendedorId         String
  dataPedido         DateTime          @default(now())
  dataEntrega        DateTime?
  tipoEntrega        TipoEntrega
  responsavelFrete   ResponsavelFrete?
  rotaId             String?
  valorFrete           Decimal?        @db.Decimal(10,2)
  valorFretePadrao     Decimal?        @db.Decimal(10, 2)
  valorFreteCobrado    Decimal?        @db.Decimal(10, 2)
  freteAlterado        Boolean         @default(false)
  motivoAlteracaoFrete String?
  nomeRecebedor      String?
  contatoRecebedor   String?
  enderecoEntrega    String?
  status             StatusPedido      @default(ABERTO)
  observacoes        String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  valorTotal         Decimal?          @db.Decimal(10, 2)
  quantidadeChapasDiretoEntrega Int?
  numeroPedidoManual String?            
  origemPedido       String            @default("INTERNO")
  historicos         HistoricoPedido[]
  cliente            Cliente           @relation(fields: [clienteId], references: [id])
  rota               RotaEntrega?      @relation(fields: [rotaId], references: [id])
  vendedor           Funcionario       @relation("VendedorPedidos", fields: [vendedorId], references: [id])
  planos             PlanoCorte[]

  @@index([numeroPedido])
  @@index([numeroPedidoManual])
  @@index([origemPedido])
  @@index([clienteId])
  @@index([vendedorId])
  @@index([rotaId])
  @@index([status])
  @@index([dataEntrega])
  @@index([createdAt])
  @@index([updatedAt])

  @@unique([origemPedido, numeroPedidoManual])
}

model PlanoCorte {
  id                  String         @id @default(cuid())
  pedidoId            String
  numeroPlano         String
  quantidadeChapas    Int            @default(0)
  medidaEncabecamento String?
  compraExterna       Boolean        @default(false)
  observacoes         String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  pedido              Pedido         @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  servicos            ServicoPlano[]

  @@index([pedidoId])
  @@index([numeroPlano])
  @@index([createdAt])
}

model TipoServico {
  id       String         @id @default(cuid())
  nome     String         @unique
  servicos ServicoPlano[]
}

model ServicoPlano {
  id            String        @id @default(cuid())
  planoId       String
  tipoServicoId String
  operadorId    String?
  status        StatusServico @default(ABERTO)
  observacoes   String?
  dataInicio    DateTime?
  dataFim       DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  operador      Funcionario?  @relation("OperadorServicos", fields: [operadorId], references: [id])
  plano         PlanoCorte    @relation(fields: [planoId], references: [id], onDelete: Cascade)
  tipoServico   TipoServico   @relation(fields: [tipoServicoId], references: [id])

  @@index([planoId])
  @@index([tipoServicoId])
  @@index([operadorId])
  @@index([status])
  @@index([dataInicio])
  @@index([dataFim])
  @@index([createdAt])
  @@index([updatedAt])
}

model HistoricoPedido {
  id        String        @id @default(cuid())
  pedidoId  String
  usuarioId String?
  tipo      TipoHistorico
  descricao String
  createdAt DateTime      @default(now())
  pedido    Pedido        @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  usuario   Usuario?      @relation(fields: [usuarioId], references: [id])

  @@index([pedidoId])
  @@index([usuarioId])
  @@index([tipo])
  @@index([createdAt])
}

enum FuncaoFuncionario {
  ADMIN
  VENDEDOR
  OPERADOR
  VENDEDOR_OPERADOR
}

enum TipoEntrega {
  CLIENTE_RETIRA
  ENTREGA_EMPRESA
}

enum ResponsavelFrete {
  CLIENTE
  EMPRESA
}

enum StatusPedido {
  ABERTO
  EM_SEPARACAO
  EM_PRODUCAO
  CONCLUIDO
  PRONTO_ENTREGA
  SAIU_ENTREGA
  ENTREGUE
  CANCELADO
}

enum StatusServico {
  ABERTO
  INICIADO
  CONCLUIDO
  CANCELADO
}

enum TipoPedido {
  COM_PRODUCAO
  DIRETO_ENTREGA
}

enum TipoHistorico {
  PEDIDO_CRIADO
  PEDIDO_ATUALIZADO
  PLANO_CRIADO
  PLANO_ATUALIZADO
  PLANO_EXCLUIDO
  SERVICO_CRIADO
  SERVICO_ATUALIZADO
  SERVICO_EXCLUIDO
  SERVICO_ASSUMIDO
  STATUS_SERVICO_ALTERADO
  STATUS_PEDIDO_ALTERADO
  EXPEDICAO_ATUALIZADA
  FRETE_ALTERADO
}
